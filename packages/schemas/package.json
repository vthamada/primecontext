{
  "name": "@primecontext/schemas",
  "version": "0.1.0",
  "description": "Versioned JSON contracts and runtime validators for PrimeContext.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vthamada/primecontext.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/vthamada/primecontext#readme",
  "bugs": {"url": "https://github.com/vthamada/primecontext/issues"},
  "keywords": ["context-engineering", "json-schema", "validation"],
  "engines": {"node": ">=22.13"},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "contracts", "scripts", "!dist/*.test.*"],
  "scripts": {
    "contracts:generate": "node ./scripts/generate-contracts.mjs",
    "contracts:check": "node ./scripts/generate-contracts.mjs --check"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts/v0.1/compact-handoff.schema.json": "./contracts/v0.1/compact-handoff.schema.json",
    "./contracts/v0.1/context-budget.schema.json": "./contracts/v0.1/context-budget.schema.json",
    "./contracts/v0.1/metric-record.schema.json": "./contracts/v0.1/metric-record.schema.json",
    "./contracts/v0.1/primecontext-config.schema.json": "./contracts/v0.1/primecontext-config.schema.json",
    "./contracts/v0.1/semantic-repo-map.schema.json": "./contracts/v0.1/semantic-repo-map.schema.json",
    "./contracts/v0.1/task-capsule.schema.json": "./contracts/v0.1/task-capsule.schema.json",
    "./contracts/v0.2/document-catalog.schema.json": "./contracts/v0.2/document-catalog.schema.json",
    "./contracts/v0.2/document-search-query.schema.json": "./contracts/v0.2/document-search-query.schema.json",
    "./contracts/v0.2/document-search-result.schema.json": "./contracts/v0.2/document-search-result.schema.json",
    "./contracts/v0.3/ablation-request.schema.json": "./contracts/v0.3/ablation-request.schema.json",
    "./contracts/v0.3/ablation-result.schema.json": "./contracts/v0.3/ablation-result.schema.json",
    "./contracts/v0.3/context-candidate.schema.json": "./contracts/v0.3/context-candidate.schema.json",
    "./contracts/v0.3/context-envelope.schema.json": "./contracts/v0.3/context-envelope.schema.json",
    "./contracts/v0.3/context-intent.schema.json": "./contracts/v0.3/context-intent.schema.json",
    "./contracts/v0.3/context-plan-request.schema.json": "./contracts/v0.3/context-plan-request.schema.json",
    "./contracts/v0.3/expansion-decision.schema.json": "./contracts/v0.3/expansion-decision.schema.json",
    "./contracts/v0.3/expansion-request.schema.json": "./contracts/v0.3/expansion-request.schema.json",
    "./contracts/v0.3/outcome-receipt.schema.json": "./contracts/v0.3/outcome-receipt.schema.json",
    "./contracts/v0.3/outcome-declaration.schema.json": "./contracts/v0.3/outcome-declaration.schema.json",
    "./contracts/v0.3/replay-result.schema.json": "./contracts/v0.3/replay-result.schema.json",
    "./contracts/v0.3/selection-receipt.schema.json": "./contracts/v0.3/selection-receipt.schema.json"
  }
}
