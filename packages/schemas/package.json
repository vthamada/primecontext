{
  "name": "@primecontext/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "contracts", "scripts", "!dist/*.test.*"],
  "scripts": {
    "contracts:generate": "node ./scripts/generate-contracts.mjs",
    "contracts:check": "node ./scripts/generate-contracts.mjs --check"
