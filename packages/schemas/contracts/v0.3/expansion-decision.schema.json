{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.3/expansion-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "previous_selection_digest",
    "selection_digest",
    "status",
    "reason_codes",
    "additions",
    "cumulative_budget",
    "remaining_missing_evidence",
    "snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "previous_selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ALLOWED",
        "PARTIAL",
        "DENIED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EVIDENCE_ADDED",
          "NO_NEW_EVIDENCE",
          "HARD_LIMIT_REACHED",
          "STALE_PARENT",
          "DUPLICATE_ONLY"
        ]
      }
    },
    "additions": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "cumulative_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_bytes",
        "max_estimated_tokens",
        "used_items",
        "used_bytes",
        "used_estimated_tokens"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "max_estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "used_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used_estimated_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "remaining_missing_evidence": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "worktree_digest"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "worktree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
