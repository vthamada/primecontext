{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.3/context-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "request_digest",
    "selection_digest",
    "policy_version",
    "snapshot",
    "evidence_status",
    "budget_status",
    "budget",
    "items",
    "criteria_coverage",
    "missing_required_sources",
    "missing_required_terms",
    "conflicts",
    "source_failures",
    "truncation"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "worktree_digest"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "worktree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capsule_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_status": {
      "enum": [
        "READY",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICT"
      ]
    },
    "budget_status": {
      "enum": [
        "WITHIN_BUDGET",
        "TRUNCATED",
        "EXHAUSTED"
      ]
    },
    "budget_tier": {
      "enum": [
        "INITIAL",
        "SOFT",
        "HARD"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_items",
        "max_bytes",
        "max_estimated_tokens",
        "used_items",
        "used_bytes",
        "used_estimated_tokens"
      ],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "max_estimated_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "used_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "used_estimated_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "kind",
          "provider",
          "path",
          "source_hash",
          "excerpt_hash",
          "snapshot",
          "freshness",
          "observed_size_bytes",
          "authority",
          "authority_evidence",
          "excerpt",
          "excerpt_bytes",
          "estimated_tokens",
          "discovery",
          "mandatory",
          "score",
          "score_components",
          "selection_reason"
        ],
        "properties": {
          "schema_version": {
            "const": "0.3"
          },
          "id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "document",
              "code",
              "test",
              "configuration",
              "history",
              "repository_map"
            ]
          },
          "provider": {
            "enum": [
              "filesystem",
              "documents",
              "repo_map",
              "git",
              "fts",
              "codegraph"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])[ .]*(?:\\.|/|$))(?!.*[. ](?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "line_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "excerpt_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "worktree_digest"
            ],
            "properties": {
              "repository_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "head": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "worktree_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "freshness": {
            "enum": [
              "live",
              "snapshot",
              "unknown"
            ]
          },
          "observed_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "authority": {
            "enum": [
              "policy",
              "adr",
              "specification",
              "contract_schema",
              "roadmap",
              "implementation_note",
              "generated_summary",
              "source_code",
              "test",
              "configuration",
              "history",
              "repository_map"
            ]
          },
          "authority_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768,
            "pattern": "^(?!(?:[^\\r\\n]*(?:\\r\\n|\\r|\\n)){400})[\\s\\S]+$",
            "x-primecontext-max-utf8-bytes": 32768,
            "x-primecontext-max-lines": 400
          },
          "excerpt_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "matched_terms",
              "criteria_ids",
              "truncated"
            ],
            "properties": {
              "matched_terms": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "criteria_ids": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              },
              "graph_distance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "truncated": {
                "type": "boolean"
              },
              "truncation_reasons": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "CANDIDATE_SET_LIMIT",
                    "EXCERPT_BOUND",
                    "PROVIDER_RESULT_LIMIT",
                    "SOURCE_COLLECTION_LIMIT"
                  ]
                }
              }
            }
          },
          "mandatory": {
            "type": "boolean"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "score_components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_source",
              "applicable_policy",
              "hinted_path",
              "hinted_symbol",
              "required_terms",
              "query_terms",
              "graph_distance",
              "authority",
              "related_test",
              "live_freshness"
            ],
            "properties": {
              "required_source": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "applicable_policy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "hinted_path": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "hinted_symbol": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "required_terms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "query_terms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "graph_distance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "authority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "related_test": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "live_freshness": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "selection_reason": {
            "enum": [
              "INCLUDE_REQUIRED_SOURCE",
              "INCLUDE_APPLICABLE_POLICY",
              "INCLUDE_CRITERION_COVERAGE",
              "INCLUDE_RELEVANCE"
            ]
          }
        }
      }
    },
    "criteria_coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "match_mode",
          "required_terms",
          "status",
          "candidate_ids",
          "matched_terms"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "match_mode": {
            "enum": [
              "ANY",
              "ALL",
              "AT_LEAST"
            ]
          },
          "minimum_matches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "required_terms": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "status": {
            "enum": [
              "COVERED",
              "MISSING",
              "CONFLICTED"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "matched_terms": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    },
    "missing_required_sources": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[<>\"|?*])(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])[ .]*(?:\\.|/|$))(?!.*[. ](?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      }
    },
    "missing_required_terms": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_key",
          "candidate_ids",
          "criterion_ids",
          "reason"
        ],
        "properties": {
          "conflict_key": {
            "type": "string",
            "pattern": "^conflict-[0-9a-f]{64}$"
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "criterion_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "reason": {
            "enum": [
              "AUTHORITATIVE_VARIANTS_REQUIRE_REVIEW",
              "AUTHORITATIVE_SOURCES_DISAGREE"
            ]
          }
        }
      }
    },
    "source_failures": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "code",
          "message",
          "security_control"
        ],
        "properties": {
          "provider": {
            "enum": [
              "filesystem",
              "documents",
              "repo_map",
              "git",
              "fts",
              "codegraph"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "security_control": {
            "type": "boolean"
          }
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "considered_candidates",
        "selected_candidates",
        "omitted_candidates",
        "source_truncated"
      ],
      "properties": {
        "considered_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "selected_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "omitted_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "source_truncated": {
          "type": "boolean"
        },
        "truncation_reasons": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CANDIDATE_SET_LIMIT",
              "EXCERPT_BOUND",
              "PROVIDER_RESULT_LIMIT",
              "SOURCE_COLLECTION_LIMIT"
            ]
          }
        }
      }
    }
  }
}
