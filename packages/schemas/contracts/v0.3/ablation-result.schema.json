{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.3/ablation-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "parent_selection_digest",
    "removed_candidate_id",
    "decision",
    "reason",
    "evidence_status",
    "missing_criteria_ids",
    "missing_required_terms",
    "experimental",
    "causal_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parent_selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ablated_selection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "removed_candidate_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "DERIVED",
        "DENIED"
      ]
    },
    "reason": {
      "enum": [
        "NON_MANDATORY_REMOVED",
        "MANDATORY_CANDIDATE",
        "CANDIDATE_NOT_SELECTED"
      ]
    },
    "evidence_status": {
      "enum": [
        "READY",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICT"
      ]
    },
    "missing_criteria_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "missing_required_terms": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "experimental": {
      "const": true
    },
    "causal_claim": {
      "const": "NONE"
    }
  }
}
