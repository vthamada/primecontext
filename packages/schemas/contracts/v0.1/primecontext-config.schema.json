{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.1/primecontext-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_dir",
    "exclude",
    "budgets"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "small_ui",
        "small_code_fix",
        "module_feature",
        "integration",
        "qa",
        "orchestration"
      ],
      "properties": {
        "small_ui": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "small_code_fix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "module_feature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "orchestration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial_tokens",
            "soft_limit_tokens",
            "hard_limit_tokens"
          ],
          "$comment": "initial_tokens <= soft_limit_tokens <= hard_limit_tokens; enforced by the runtime validator.",
          "properties": {
            "initial_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "soft_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "hard_limit_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  }
}
