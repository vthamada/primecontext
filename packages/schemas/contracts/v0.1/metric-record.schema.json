{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.1/metric-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?(?![\\s\\S])"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "A",
        "B"
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "agent_output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "file_reads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "codegraph_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context_expansions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selected_context_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "test_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "review_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "completion_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "rework_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimated_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "agent_output_tokens",
          "tool_calls",
          "file_reads",
          "codegraph_calls",
          "context_expansions",
          "duration_ms",
          "selected_context_tokens",
          "rework_count"
        ]
      },
      "$comment": "Each estimated field must also be present as a measurement; enforced by the runtime validator."
    },
    "run_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "worktree_digest",
        "agent",
        "model",
        "reasoning_effort",
        "permissions",
        "runtime",
        "lockfile_hash",
        "time_limit_ms",
        "test_command",
        "rubric"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "worktree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "permissions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "lockfile_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "time_limit_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "test_command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "rubric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      }
    }
  }
}
