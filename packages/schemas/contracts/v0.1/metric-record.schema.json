{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primecontext.dev/schemas/v0.1/metric-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|(?![\\s\\S])))[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?(?![\\s\\S])"
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "A",
        "B"
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "file_reads": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "codegraph_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "context_expansions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selected_context_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "test_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "review_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "completion_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "rework_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "estimated_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "tool_calls",
          "file_reads",
          "codegraph_calls",
          "context_expansions",
          "duration_ms",
          "selected_context_tokens",
          "rework_count"
        ]
      },
      "$comment": "Each estimated field must also be present as a measurement; enforced by the runtime validator."
    }
  }
}
